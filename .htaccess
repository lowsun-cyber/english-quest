# Хостинг (Спринтхост): файлы из папки, где лежит .htaccess, отдаёт Apache — тогда работают правила ниже.
# Страницы браузер сверяет с сервером при каждом открытии, поэтому после выкладки сразу видна новая версия.
# Скрипты и стили подключаются с версией в адресе (?v=…, tools/stamp.mjs), поэтому их недельный кэш не мешает.
DirectoryIndex index.html
Options -Indexes

# только https (адрес http:// перенаправляется)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # папка без «/» на конце (/admin) — сразу на https-адрес со «/». Иначе «/» добавляет сам Apache, но с http://,
  # и Safari уходит на главную (см. navigate в sw.js)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI}/ [R=301,L]
</IfModule>

# шрифты лежат на сайте (assets/fonts) — правильный тип, чтобы браузер их принял
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "(\.html|\.webmanifest|\.json|^sw\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
