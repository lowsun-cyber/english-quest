# Все адреса API → index.php
Options -Indexes
DirectoryIndex index.php
# сама веб-папка API открыта, даже если выше стоит запрет (server/.htaccess)
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>
